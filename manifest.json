{
  "manifest_version": 3,
  "name": "Anti Scroll",
  "version": "0.1.0",
  "description": "Stops scroll loops on selected sites while leaving the rest of the web alone.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Anti Scroll"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reddit.com/*",
        "https://*.reddit.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.youtu.be/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://threads.com/*",
        "https://*.threads.com/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://bsky.app/*",
        "https://*.bsky.app/*",
        "https://twitch.tv/*",
        "https://*.twitch.tv/*",
        "https://substack.com/*",
        "https://*.substack.com/*",
        "https://github.com/*",
        "https://*.github.com/*",
        "https://news.ycombinator.com/*",
        "https://*.news.ycombinator.com/*"
      ],
      "js": ["src/page-lock.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://reddit.com/*",
        "https://*.reddit.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.youtu.be/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://threads.com/*",
        "https://*.threads.com/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://bsky.app/*",
        "https://*.bsky.app/*",
        "https://twitch.tv/*",
        "https://*.twitch.tv/*",
        "https://substack.com/*",
        "https://*.substack.com/*",
        "https://github.com/*",
        "https://*.github.com/*",
        "https://news.ycombinator.com/*",
        "https://*.news.ycombinator.com/*"
      ],
      "js": ["src/constants.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "host_permissions": [
    "https://reddit.com/*",
    "https://*.reddit.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.youtu.be/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://threads.com/*",
    "https://*.threads.com/*",
    "https://threads.net/*",
    "https://*.threads.net/*",
    "https://bsky.app/*",
    "https://*.bsky.app/*",
    "https://twitch.tv/*",
    "https://*.twitch.tv/*",
    "https://substack.com/*",
    "https://*.substack.com/*",
    "https://github.com/*",
    "https://*.github.com/*",
    "https://news.ycombinator.com/*",
    "https://*.news.ycombinator.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["activeTab", "alarms", "scripting", "storage", "webNavigation"]
}
